# Which LLM provider runs the agent: "anthropic" (default) or "gemini"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: reasoning effort for Anthropic (low | medium | high), default medium
LLM_EFFORT=
